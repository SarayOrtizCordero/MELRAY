{
  "rewrites": [
    { "source": "/cookies.html", "destination": "/pages/cookies.html" },
    { "source": "/privacidad.html", "destination": "/pages/privacidad.html" },
    { "source": "/terminos.html", "destination": "/pages/terminos.html" },
    { "source": "/tu-web.html", "destination": "/pages/tu-web.html" }
  ],
  "redirects": [
    { "source": "/automatizaciones.html", "destination": "/", "permanent": true },
    { "source": "/crm.html", "destination": "/", "permanent": true },
    { "source": "/websites.html", "destination": "/", "permanent": true },
    { "source": "/inventario.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self'; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" }
      ]
    }
  ]
}
